{
  "name": "geomancer",
  "version": "0.0.0",
  "description": "Worldbuilding tools",
  "main": "index.js",
  "author": "Kenneth Pirman <mail@kenny.wtf>",
  "repository": "https://github.com/kenjinp/geomancer.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "yarn workspace @geomancer/electron start",
    "start:desktop": "cd desktop && yarn start",
