92:		
93:		float noaaRampElevations[NOAA_RAMP_SIZE] = float[](
94:		    8000.0,
95:		    4000.0, 
96:		    2000.0,
97:		    1000.0,
98:		    500.0,
99:		    250.0,
100:		    50.0,
101:		    10.0,
102:		    0.1,
103:		    0.0,
104:		    -2.0,
105:		    -10.0,
106:		    -50.0,
107:		    -250.0,
108:		    -1000.0,
109:		    -2000.0,
110:		    -4000.0,
111:		    -8000.0
112:		);
113:		
114:		vec4 getColorForElevation(float elevation) {
115:		    
116:		    if (elevation >= noaaRampElevations[0]) {
117:		        return noaaRampColors[0];
118:		    }
119:		    if (elevation <= noaaRampElevations[NOAA_RAMP_SIZE-1]) {
120:		        return noaaRampColors[NOAA_RAMP_SIZE-1];
121:		    }
122:		
123:		    
124:		    for (int i = 0; i < NOAA_RAMP_SIZE-1; i++) {
125:		        if (elevation <= noaaRampElevations[i] && elevation > noaaRampElevations[i+1]) {
126:		            
127:		            float t = (elevation - noaaRampElevations[i+1]) / 
128:		                     (noaaRampElevations[i] - noaaRampElevations[i+1]);
129:		            return mix(noaaRampColors[i+1], noaaRampColors[i], t);
130:		        }
131:		    }
132:		
133:		    
134:		    return noaaRampColors[0];
135:		}
136:		
137:		float remap(in float value, in float x1, in float y1, in float x2, in float y2) {
138:		    return ((value - x1) * (y2 - x2)) / (y1 - x1) + x2;
139:		}
140:		
141:		float greatCircleDistance(vec3 a, vec3 b) {
142:		    
143:		    vec3 na = normalize(a);
144:		    vec3 nb = normalize(b);
145:		    
146:		    
147:		    float cosTheta = clamp(dot(na, nb), -1.0, 1.0);
148:		    
149:		    
150:		    return acos(cosTheta);
151:		}
