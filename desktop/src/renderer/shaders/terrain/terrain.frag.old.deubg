153:		const float RAD2DEG = 180.0 / 3.1415926535897932384626433832795;
154:		struct LatLong {
155:		    float lat;
156:		    float lon;
157:		};
158:		
159:		LatLong getLatLong(vec3 position, float radius) {
160:		    
161:		    float longitude = atan(position.x, position.z) * RAD2DEG;
162:		    float latitude = atan(-position.y, length(position.xz)) * RAD2DEG;
163:		    return LatLong(latitude, longitude);
164:		}
165:		
166:		vec2 getLatLongUV(LatLong latLong) {
167:		    return vec2(
168:		        remap(latLong.lon, -180., 180., 0., 1.),
169:		        remap(latLong.lat, -90., 90., 0., 1.)
170:		    );
171:		}
172:		bool getMapLayer(uint layer) {
173:		    return bool((uMapLayers >> layer) & 1u);
174:		}
175:		vec2 random2(float n) {
176:		    vec2 s = vec2(n);
177:		    return -1.0 + 2.0 * fract(sin(vec2(dot(s,vec2(127.1,311.7)),
178:		                                     dot(s,vec2(269.5,183.3))))*43758.5453123);
179:		}
180:		
181:		vec3 hash31(float p) {
182:		   vec3 p3 = fract(vec3(p) * vec3(.1031, .1030, .0973));
183:		   p3 += dot(p3, p3.yzx+33.33);
184:		   return fract((p3.xxy+p3.yzz)*p3.zyx); 
185:		}
186:		
187:		vec3 hashFloat(float f) {
188:		    
189:		    uint seed = uint(f);
190:		    
191:		    
192:		    seed ^= (seed << 13u);
193:		    seed ^= (seed >> 17u);
194:		    seed ^= (seed << 5u);
195:		    
196:		    
197:		    return vec3(
198:		        float((seed >> 16u) & 0xFFu) / 255.0,
199:		        float((seed >> 8u) & 0xFFu) / 255.0,
200:		        float(seed & 0xFFu) / 255.0
201:		    );
202:		}
203:		
204:		vec3 jitterPosition(vec3 position, float seed, float amount) {
205:		    
206:		    vec2 rand = random2(seed);
207:		    vec3 tangent = normalize(cross(position, vec3(0.0, 1.0, 0.0)));
208:		    vec3 bitangent = normalize(cross(position, tangent));
209:		    
210:		    
211:		    return normalize(position + (tangent * rand.x + bitangent * rand.y) * amount);
212:		}
213:		uint getNeighborH3Id(float baseId, float direction) {
214:		    
215:		    float index = baseId * 6.0 + direction;
216:		    vec2 texSize = vec2(textureSize(h3NeighborMap, 0));
217:		    float texWidth = texSize.x;
218:		    float texHeight = texSize.y;
219:		
220:		    
221:		    float row = floor(index / texWidth);
222:		    float col = mod(index, texWidth);
223:		
224:		    
225:		    vec2 uv = vec2(
226:		        (col + 0.5) / texWidth,
227:		        (row + 0.5) / texHeight
228:		    );
229:		
230:		    vec4 packed = texture2D(h3NeighborMap, uv);
231:		    
232:		    
233:		    uint r = uint(floor(packed.r * 255.0 + 0.5));
234:		    uint g = uint(floor(packed.g * 255.0 + 0.5));
235:		    uint b = uint(floor(packed.b * 255.0 + 0.5));
236:		    
237:		    
238:		    if (r == 255u && g == 255u && b == 255u) {
239:		        return 0u;
240:		    }
241:		    
242:		    return (r << 16u) | (g << 8u) | b;
243:		}
244:		
245:		vec3 getH3Position(float h3Id) {
246:		    ivec2 texSize = textureSize(h3PositionMap, 0);
247:		    float texWidth = float(texSize.x);
248:		    float texHeight = float(texSize.y);
249:		    
250:		    
251:		    float row = floor(h3Id / texWidth);
252:		    float col = h3Id - row * texWidth;
253:		
254:		    
255:		    row = min(row, texHeight - 1.0);
256:		
257:		    
258:		    vec2 uv = vec2(
259:		        (col + 0.5) / texWidth,
260:		        (row + 0.5) / texHeight
261:		    );
262:		
263:		    vec3 position = texture2D(h3PositionMap, uv).xyz;
264:		    
265:		    return position;
266:		}
267:		
268:		uint getH3IdentifierCube(vec3 direction) {
269:		    vec4 color = textureCube(h3IndexMap, direction);
270:		    uint r = uint(floor(color.r * 255.0 + 0.5));
271:		    uint g = uint(floor(color.g * 255.0 + 0.5));
272:		    uint b = uint(floor(color.b * 255.0 + 0.5));
273:		
274:		    
275:		    if (r == 255u && g == 255u && b == 255u) {
276:		        return 0u;
277:		    }
278:		
279:		    return (r << 16) | (g << 8) | b;
280:		}
281:		
282:		uint findClosestCell(vec3 position, uint initialId) {
283:		    vec3 normalizedPos = normalize(position);
284:		    vec3 initialCenter = normalize(getH3Position(float(initialId)));
285:		    float minDist = greatCircleDistance(normalizedPos, initialCenter);
286:		    uint closestId = initialId;
287:		    
288:		    for (int i = 0; i < 6; i++) {
289:		        uint neighborId = getNeighborH3Id(float(initialId), float(i));
290:		        if (neighborId == 0u) continue;
291:		        
292:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
293:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
294:		        
295:		        if (dist < minDist) {
296:		            minDist = dist;
297:		            closestId = neighborId;
298:		        }
299:		    }
300:		    
301:		    return closestId;
302:		}
303:		
304:		vec2 findClosestAndSecondClosestCell(vec3 position, uint initialId) {
305:		    vec3 normalizedPos = normalize(position);
306:		    vec3 initialCenter = normalize(getH3Position(float(initialId)));
307:		    float minDist = greatCircleDistance(normalizedPos, initialCenter);
308:		    float secondMinDist = 1000.0;
309:		    uint closestId = initialId;
310:		    uint secondClosestId = initialId;
311:		    
312:		    for (int i = 0; i < 6; i++) {
313:		        uint neighborId = getNeighborH3Id(float(initialId), float(i));
314:		        if (neighborId == 0u) continue;
315:		        
316:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
317:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
318:		        
319:		        if (dist < minDist) {
320:		            secondMinDist = minDist;
321:		            secondClosestId = closestId;
322:		            minDist = dist;
323:		            closestId = neighborId;
324:		        } else if (dist < secondMinDist) {
325:		            secondMinDist = dist;
326:		            secondClosestId = neighborId;
327:		        }
328:		    }
329:		    
330:		    return vec2(float(closestId), float(secondClosestId));
331:		}
332:		vec2 getHexTileUV(float tileIndex, vec2 textureSize) {
333:		    float row = floor(tileIndex / textureSize.x);
334:		    float col = mod(tileIndex, textureSize.x);
335:		    
336:		    return vec2(
337:		        (col + 0.5) / textureSize.x,
338:		        (row + 0.5) / textureSize.y
339:		    );
340:		}
