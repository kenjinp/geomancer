72:		vec4 noaaRampColors[NOAA_RAMP_SIZE] = vec4[](
73:		    vec4(1.0, 1.0, 1.0, 1.0),      
74:		    vec4(0.878, 0.843, 0.816, 1.0), 
75:		    vec4(0.804, 0.725, 0.612, 1.0), 
76:		    vec4(0.729, 0.580, 0.408, 1.0), 
77:		    vec4(0.608, 0.494, 0.263, 1.0), 
78:		    vec4(0.459, 0.459, 0.176, 1.0), 
79:		    vec4(0.271, 0.424, 0.094, 1.0), 
80:		    vec4(0.090, 0.333, 0.082, 1.0), 
81:		    vec4(0.000, 0.251, 0.137, 1.0), 
82:		    vec4(0.878, 0.988, 0.894, 1.0), 
83:		    vec4(0.671, 0.886, 0.843, 1.0), 
84:		    vec4(0.475, 0.776, 0.804, 1.0), 
85:		    vec4(0.361, 0.675, 0.792, 1.0), 
86:		    vec4(0.247, 0.569, 0.780, 1.0), 
87:		    vec4(0.176, 0.459, 0.690, 1.0), 
88:		    vec4(0.133, 0.333, 0.502, 1.0), 
89:		    vec4(0.114, 0.251, 0.322, 1.0), 
90:		    vec4(0.102, 0.204, 0.204, 1.0)  
