379:		struct HexTileFloatData {
380:		    float evapotranspiration;
381:		    float annualPrecipitation;
382:		    float annualTemperature;
383:		    float elevation;
384:		};
385:		
386:		float validateHexTileFloatData(float tileIndex) {
387:		    vec2 textureSize = vec2(textureSize(hexTileFloatBuffer, 0));
388:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
389:		    vec4 data = texture2D(hexTileFloatBuffer, uv);
390:		    return data.a;
391:		}
392:		
393:		HexTileFloatData getHexTileFloatData(float tileIndex) {
394:		    vec2 textureSize = vec2(textureSize(hexTileFloatBuffer, 0));
395:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
396:		    vec4 data = texture2D(hexTileFloatBuffer, uv);
397:		    
398:		    HexTileFloatData result;
399:		    result.evapotranspiration = data.r;
400:		    result.annualPrecipitation = data.g * 5000.0; 
401:		    result.annualTemperature = data.b * 100.0 - 50.0; 
402:		    result.elevation = data.a;
403:		    
404:		    return result;
405:		}
406:		float getGrid(vec2 localPosition, float size, float thickness) {
407:		    vec2 r = localPosition.xy / size;
408:		    vec2 grid = abs(fract(r - 0.5) - 0.5) / fwidth(r);
409:		    float line = min(grid.x, grid.y) + 1.0 - thickness;
410:		    return 1.0 - min(line, 1.0);
411:		}
412:		
413:		float getGridFromFloat(float localPosition, float size, float thickness) {
414:		    float r = localPosition / size;
415:		    float grid = abs(fract(r - 0.5) - 0.5) / fwidth(r);
416:		    float line = grid + 1.0 - thickness;
417:		    return 1.0 - min(line, 1.0);
418:		}
419:		
420:		float getEdgeFactor(vec3 position, uint cellId, float edgeWidth) {
421:		    vec3 normalizedPos = normalize(position);
422:		    vec3 cellCenter = normalize(getH3Position(float(cellId)));
423:		    float distToCenter = greatCircleDistance(normalizedPos, cellCenter);
424:		    
425:		    
426:		    float minNeighborDist = 1000.0;
427:		    for (int i = 0; i < 6; i++) {
428:		        uint neighborId = getNeighborH3Id(float(cellId), float(i));
429:		        if (neighborId == 0u) continue;
430:		        
431:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
432:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
433:		        minNeighborDist = min(minNeighborDist, dist);
434:		    }
435:		    
436:		    
437:		    float edgeSharpness = 4.0;
438:		    
439:		    
440:		    float edgeFactor = abs(distToCenter - minNeighborDist);
441:		    return 1.0 - smoothstep(0.0, edgeWidth, edgeFactor * edgeSharpness);
442:		}
443:		float calculateDiffuseLighting(vec3 normal, vec3 lightDir) {
444:		    return max(dot(normal, lightDir), 0.0);
445:		}
446:		
447:		vec3 calculateSurfaceNormal(vec3 position, uint cellId) {
448:		    
449:		    vec3 cellCenter = normalize(getH3Position(float(cellId)));
450:		    
451:		    
452:		    return normalize(position);
453:		}
454:		
455:		vec3 applyLighting(vec3 baseColor, vec3 normal, vec3 lightDir) {
456:		    
457:		    float ambientStrength = 0.00001;
458:		    vec3 ambient = ambientStrength * baseColor;
459:		    
460:		    
461:		    float diff = calculateDiffuseLighting(normal, lightDir);
462:		    vec3 diffuse = diff * baseColor;
463:		    
464:		    
465:		    return ambient + diffuse;
466:		}
467:		
468:		varying vec2 vUv;
469:		varying vec4 vWorldPosition;
470:		varying float vInstanceId;
471:		
472:		void main() {
473:		    vec3 worldPos = vWorldPosition.xyz / vWorldPosition.w;
474:		    vec3 sphereDirection = normalize(worldPos - uOffset);
475:		    vec3 spherePos = uOffset + sphereDirection * uRadius;
476:		    
477:		    uint currentId = getH3IdentifierCube(sphereDirection);
478:		
479:		    vec2 closestAndSecondClosest = findClosestAndSecondClosestCell(spherePos, currentId);
480:		    uint closestId = uint(closestAndSecondClosest.x);
481:		    uint secondClosestId = uint(closestAndSecondClosest.y);
482:		
483:		    
484:		    LatLong latlong = getLatLong(worldPos, uRadius);
485:		    float lineWidth = 1.0;
486:		    float latRepititions = 18.;
487:		    float lonRepititions = 36.;
488:		    vec2 latlongUV = vec2(
489:		        -remap(latlong.lat, -90., 90., 0., 1.),
490:		        remap(latlong.lon, -180., 180., 0., 1.)
491:		    );
492:		    vec2 latlongUVWithReps = vec2(
493:		        latlongUV.x * latRepititions,
494:		        latlongUV.y * lonRepititions
495:		    );
496:		
497:		    
498:		    vec3 currentCellColor = hashFloat(float(currentId));
499:		    vec3 cellColor = hashFloat(float(closestId));
500:		    
501:		    
502:		    HexTileIntData intData = getHexTileIntData(float(closestId));
503:		    HexTileFloatData floatData = getHexTileFloatData(float(closestId));
504:		
505:		    HexTileIntData secondIntData = getHexTileIntData(float(secondClosestId));
506:		    HexTileFloatData secondFloatData = getHexTileFloatData(float(secondClosestId));
507:		
508:		    float elevation = floatData.elevation;
509:		
510:		    
511:		    vec3 baseColor = vec3(0.3);
512:		
513:		    if (uMapMode == 1u) {
514:		        baseColor = getColorForElevation(remap(elevation, -1.0, 1.0, -8000.0, 8000.0)).rgb;
515:		    }
516:		    if (uMapMode == 2u) {
517:		        baseColor = vec3(hashFloat(float(intData.tectonicPlate)));
518:		    }
519:		    if (uMapMode == 3u) {
520:		        baseColor = cellColor;
521:		    }
522:		
523:		    
524:		    float showGrid = 0.0;
525:		    if (getMapLayer(1u)) {
526:		        showGrid = 1.0;
527:		    }
528:		
529:		    
530:		    float axialTilt = 23.4;
531:		    vec2 arcticCircleLines = vec2(90.- - axialTilt, - (90.- - axialTilt));
532:		    vec2 tropicLines = vec2(axialTilt, -axialTilt);
533:		
534:		    float uSubgridAlpha = 0.0;
535:		    float uContourAlpha = 0.0;
536:		    float uLatLongGridAlpha = 0.5;
537:		    float uPolarCirclesAlpha = 1.0;
538:		    float uTropicsAlpha = 1.0;
539:		    float uEquatorAlpha = 1.0;
540:		    float uPrimeMeridianAlpha = 0.8;
541:		    
542:		    
543:		    float grid = getGrid(latlongUVWithReps, 1.0, lineWidth) * uLatLongGridAlpha;
544:		    float grid2 = getGrid(latlongUVWithReps, 0.5, lineWidth) * uSubgridAlpha;
545:		    float grid3 = getGrid(latlongUVWithReps, 0.1, lineWidth) * uSubgridAlpha;
546:		    float combinedGrid = (grid + grid2 + grid3) * showGrid;
547:		
548:		    
549:		    vec3 lightDir = normalize(vec3(1.0, 0.4, 0.0)); 
550:		    
551:		    
552:		    
553:		    
554:		    
555:		    
556:		
557:		    vec3 whiteGridColors = mix(baseColor, vec3(1.0), combinedGrid);
558:		
559:		    
560:		    float primeMeridian = getGridFromFloat(latlongUV.y, 0.5, lineWidth * 1.2);
561:		    float equator = getGridFromFloat(latlongUV.x, 0.5, lineWidth * 1.2);
562:		    float tropicCapricorn = getGridFromFloat(latlongUV.x + remap(tropicLines.x, -90., 90., 0., 1.), 1.0, lineWidth * 1.2);
563:		    float tropicCancer = getGridFromFloat(latlongUV.x + remap(tropicLines.y, -90., 90., 0., 1.), 1.0, lineWidth * 1.2);
564:		    float arcticCircle = getGridFromFloat(latlongUV.x + remap(arcticCircleLines.x, -90., 90., 0., 1.), 1.0 , lineWidth * 1.2);
565:		    float antarcticCircle = getGridFromFloat(latlongUV.x + remap(arcticCircleLines.y, -90., 90., 0., 1.), 1.0, lineWidth * 1.2);
566:		    float combinedGrid2 = primeMeridian + equator;
567:		    float tropics = tropicCapricorn + tropicCancer;
568:		    float polarCircles = arcticCircle + antarcticCircle;
569:		
570:		    vec3 combinedGridColors = mix(whiteGridColors, vec3(1.0, 0.0, 0.0), combinedGrid2 * uLatLongGridAlpha * showGrid);
571:		    combinedGridColors = mix(combinedGridColors, vec3(1.0, 1.0, 0.0), tropics * uTropicsAlpha * showGrid);
572:		    combinedGridColors = mix(combinedGridColors, vec3(1.0, 1.0, 0.0), polarCircles * uPolarCirclesAlpha * showGrid);
573:		
574:		    
575:		    if (uSelectedTile > -1.0 && uSelectedTile == float(closestId)) {
576:		        combinedGridColors = vec3(1.0, 0.0, 0.0);
577:		    }
578:		
579:		    
580:		    vec3 edgeColor = vec3(0.0, 0.0, 0.0);
581:		    bool isEdge = intData.tectonicPlate != secondIntData.tectonicPlate;
582:		    float edgeWidth = 0.0006;
583:		    
584:		    float edge = 0.0;
585:		    if (getMapLayer(0u)) {
586:		        edge = getEdgeFactor(spherePos, closestId, edgeWidth);
587:		    }
588:		
589:		    vec3 finalColor = mix(combinedGridColors, edgeColor, edge);
590:		    finalColor = mix(finalColor, hashFloat(vInstanceId), 0.0);
591:		
592:		    
593:		    gl_FragColor = vec4(finalColor, 1.0);
594:		}