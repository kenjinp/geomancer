342:		struct HexTileIntData {
343:		    uint tectonicPlate;
344:		    uint crustData;
345:		    uint biomeData;
346:		    uint reserved;
347:		};
348:		
349:		HexTileIntData getHexTileIntData(float tileIndex) {
350:		    vec2 textureSize = vec2(textureSize(hexTileIntBuffer, 0));
351:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
352:		    uvec4 rawData = texture(hexTileIntBuffer, uv);
353:		    
354:		    HexTileIntData result;
355:		    result.tectonicPlate = rawData.r;
356:		    result.crustData = rawData.g;
357:		    result.biomeData = rawData.b;
358:		    result.reserved = rawData.a;
359:		    
360:		    return result;
361:		}
362:		
363:		bool isOceanicCrust(uint crustData) {
364:		    return (crustData / 10u) == 0u;
365:		}
366:		
367:		uint getCrustSubtype(uint crustData) {
368:		    return crustData % 10u;
369:		}
370:		
371:		uint getBiomeType(uint biomeData) {
372:		    return biomeData >> 1u;
373:		}
374:		
375:		bool hasHotspot(uint biomeData) {
376:		    return (biomeData & 1u) == 1u;
377:		}
