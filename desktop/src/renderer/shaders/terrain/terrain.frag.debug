928:		float IBLSheenBRDF( const in vec3 normal, const in vec3 viewDir, const in float roughness ) {
929:		  float dotNV = saturate( dot( normal, viewDir ) );
930:		  float r2 = roughness * roughness;
931:		  float a = roughness < 0.25 ? -339.2 * r2 + 161.4 * roughness - 25.9 : -8.48 * r2 + 14.3 * roughness - 9.95;
932:		  float b = roughness < 0.25 ? 44.0 * r2 - 23.7 * roughness + 3.26 : 1.97 * r2 - 3.27 * roughness + 0.72;
933:		  float DG = exp( a * dotNV + b ) + ( roughness < 0.25 ? 0.0 : 0.1 * ( roughness - 0.25 ) );
934:		  return saturate( DG * RECIPROCAL_PI );
935:		}
936:		vec2 DFGApprox( const in vec3 normal, const in vec3 viewDir, const in float roughness ) {
937:		  float dotNV = saturate( dot( normal, viewDir ) );
938:		  const vec4 c0 = vec4( - 1, - 0.0275, - 0.572, 0.022 );
939:		  const vec4 c1 = vec4( 1, 0.0425, 1.04, - 0.04 );
940:		  vec4 r = roughness * c0 + c1;
941:		  float a004 = min( r.x * r.x, exp2( - 9.28 * dotNV ) ) * r.x + r.y;
942:		  vec2 fab = vec2( - 1.04, 1.04 ) * a004 + r.zw;
943:		  return fab;
944:		}
945:		vec3 EnvironmentBRDF( const in vec3 normal, const in vec3 viewDir, const in vec3 specularColor, const in float specularF90, const in float roughness ) {
946:		  vec2 fab = DFGApprox( normal, viewDir, roughness );
947:		  return specularColor * fab.x + specularF90 * fab.y;
948:		}
949:		#ifdef USE_IRIDESCENCE
950:		void computeMultiscatteringIridescence( const in vec3 normal, const in vec3 viewDir, const in vec3 specularColor, const in float specularF90, const in float iridescence, const in vec3 iridescenceF0, const in float roughness, inout vec3 singleScatter, inout vec3 multiScatter ) {
951:		#else
952:		void computeMultiscattering( const in vec3 normal, const in vec3 viewDir, const in vec3 specularColor, const in float specularF90, const in float roughness, inout vec3 singleScatter, inout vec3 multiScatter ) {
953:		#endif
954:		  vec2 fab = DFGApprox( normal, viewDir, roughness );
955:		  #ifdef USE_IRIDESCENCE
956:		    vec3 Fr = mix( specularColor, iridescenceF0, iridescence );
957:		  #else
958:		    vec3 Fr = specularColor;
959:		  #endif
960:		  vec3 FssEss = Fr * fab.x + specularF90 * fab.y;
961:		  float Ess = fab.x + fab.y;
962:		  float Ems = 1.0 - Ess;
963:		  vec3 Favg = Fr + ( 1.0 - Fr ) * 0.047619;  vec3 Fms = FssEss * Favg / ( 1.0 - Ems * Favg );
964:		  singleScatter += FssEss;
965:		  multiScatter += Fms * Ems;
966:		}
