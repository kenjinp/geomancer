781:		vec3 Schlick_to_F0( const in vec3 f, const in float f90, const in float dotVH ) {
782:		    float x = clamp( 1.0 - dotVH, 0.0, 1.0 );
783:		    float x2 = x * x;
784:		    float x5 = clamp( x * x2 * x2, 0.0, 0.9999 );
785:		    return ( f - vec3( f90 ) * x5 ) / ( 1.0 - x5 );
786:		}
787:		float V_GGX_SmithCorrelated( const in float alpha, const in float dotNL, const in float dotNV ) {
788:		  float a2 = pow2( alpha );
789:		  float gv = dotNL * sqrt( a2 + ( 1.0 - a2 ) * pow2( dotNV ) );
790:		  float gl = dotNV * sqrt( a2 + ( 1.0 - a2 ) * pow2( dotNL ) );
791:		  return 0.5 / max( gv + gl, EPSILON );
792:		}
793:		float D_GGX( const in float alpha, const in float dotNH ) {
794:		  float a2 = pow2( alpha );
795:		  float denom = pow2( dotNH ) * ( a2 - 1.0 ) + 1.0;
796:		  return RECIPROCAL_PI * a2 / pow2( denom );
797:		}
798:		#ifdef USE_ANISOTROPY
799:		  float V_GGX_SmithCorrelated_Anisotropic( const in float alphaT, const in float alphaB, const in float dotTV, const in float dotBV, const in float dotTL, const in float dotBL, const in float dotNV, const in float dotNL ) {
800:		    float gv = dotNL * length( vec3( alphaT * dotTV, alphaB * dotBV, dotNV ) );
801:		    float gl = dotNV * length( vec3( alphaT * dotTL, alphaB * dotBL, dotNL ) );
802:		    float v = 0.5 / ( gv + gl );
803:		    return saturate(v);
804:		  }
805:		  float D_GGX_Anisotropic( const in float alphaT, const in float alphaB, const in float dotNH, const in float dotTH, const in float dotBH ) {
806:		    float a2 = alphaT * alphaB;
807:		    highp vec3 v = vec3( alphaB * dotTH, alphaT * dotBH, a2 * dotNH );
808:		    highp float v2 = dot( v, v );
809:		    float w2 = a2 / v2;
810:		    return RECIPROCAL_PI * a2 * pow2 ( w2 );
811:		  }
812:		#endif
813:		#ifdef USE_CLEARCOAT
814:		  vec3 BRDF_GGX_Clearcoat( const in vec3 lightDir, const in vec3 viewDir, const in vec3 normal, const in PhysicalMaterial material) {
815:		    vec3 f0 = material.clearcoatF0;
816:		    float f90 = material.clearcoatF90;
817:		    float roughness = material.clearcoatRoughness;
818:		    float alpha = pow2( roughness );
819:		    vec3 halfDir = normalize( lightDir + viewDir );
820:		    float dotNL = saturate( dot( normal, lightDir ) );
821:		    float dotNV = saturate( dot( normal, viewDir ) );
822:		    float dotNH = saturate( dot( normal, halfDir ) );
823:		    float dotVH = saturate( dot( viewDir, halfDir ) );
824:		    vec3 F = F_Schlick( f0, f90, dotVH );
825:		    float V = V_GGX_SmithCorrelated( alpha, dotNL, dotNV );
826:		    float D = D_GGX( alpha, dotNH );
827:		    return F * ( V * D );
828:		  }
829:		#endif
830:		vec3 BRDF_GGX( const in vec3 lightDir, const in vec3 viewDir, const in vec3 normal, const in PhysicalMaterial material ) {
831:		  vec3 f0 = material.specularColor;
832:		  float f90 = material.specularF90;
833:		  float roughness = material.roughness;
834:		  float alpha = pow2( roughness );
835:		  vec3 halfDir = normalize( lightDir + viewDir );
836:		  float dotNL = saturate( dot( normal, lightDir ) );
837:		  float dotNV = saturate( dot( normal, viewDir ) );
838:		  float dotNH = saturate( dot( normal, halfDir ) );
839:		  float dotVH = saturate( dot( viewDir, halfDir ) );
840:		  vec3 F = F_Schlick( f0, f90, dotVH );
841:		  #ifdef USE_IRIDESCENCE
842:		    F = mix( F, material.iridescenceFresnel, material.iridescence );
843:		  #endif
844:		  #ifdef USE_ANISOTROPY
845:		    float dotTL = dot( material.anisotropyT, lightDir );
846:		    float dotTV = dot( material.anisotropyT, viewDir );
847:		    float dotTH = dot( material.anisotropyT, halfDir );
848:		    float dotBL = dot( material.anisotropyB, lightDir );
849:		    float dotBV = dot( material.anisotropyB, viewDir );
850:		    float dotBH = dot( material.anisotropyB, halfDir );
851:		    float V = V_GGX_SmithCorrelated_Anisotropic( material.alphaT, alpha, dotTV, dotBV, dotTL, dotBL, dotNV, dotNL );
852:		    float D = D_GGX_Anisotropic( material.alphaT, alpha, dotNH, dotTH, dotBH );
853:		  #else
854:		    float V = V_GGX_SmithCorrelated( alpha, dotNL, dotNV );
855:		    float D = D_GGX( alpha, dotNH );
856:		  #endif
857:		  return F * ( V * D );
858:		}
859:		vec2 LTC_Uv( const in vec3 N, const in vec3 V, const in float roughness ) {
860:		  const float LUT_SIZE = 64.0;
861:		  const float LUT_SCALE = ( LUT_SIZE - 1.0 ) / LUT_SIZE;
862:		  const float LUT_BIAS = 0.5 / LUT_SIZE;
863:		  float dotNV = saturate( dot( N, V ) );
864:		  vec2 uv = vec2( roughness, sqrt( 1.0 - dotNV ) );
865:		  uv = uv * LUT_SCALE + LUT_BIAS;
866:		  return uv;
867:		}
868:		float LTC_ClippedSphereFormFactor( const in vec3 f ) {
869:		  float l = length( f );
870:		  return max( ( l * l + f.z ) / ( l + 1.0 ), 0.0 );
871:		}
872:		vec3 LTC_EdgeVectorFormFactor( const in vec3 v1, const in vec3 v2 ) {
873:		  float x = dot( v1, v2 );
874:		  float y = abs( x );
875:		  float a = 0.8543985 + ( 0.4965155 + 0.0145206 * y ) * y;
876:		  float b = 3.4175940 + ( 4.1616724 + y ) * y;
877:		  float v = a / b;
878:		  float theta_sintheta = ( x > 0.0 ) ? v : 0.5 * inversesqrt( max( 1.0 - x * x, 1e-7 ) ) - v;
879:		  return cross( v1, v2 ) * theta_sintheta;
880:		}
881:		vec3 LTC_Evaluate( const in vec3 N, const in vec3 V, const in vec3 P, const in mat3 mInv, const in vec3 rectCoords[ 4 ] ) {
882:		  vec3 v1 = rectCoords[ 1 ] - rectCoords[ 0 ];
883:		  vec3 v2 = rectCoords[ 3 ] - rectCoords[ 0 ];
884:		  vec3 lightNormal = cross( v1, v2 );
885:		  if( dot( lightNormal, P - rectCoords[ 0 ] ) < 0.0 ) return vec3( 0.0 );
886:		  vec3 T1, T2;
887:		  T1 = normalize( V - N * dot( V, N ) );
888:		  T2 = - cross( N, T1 );
889:		  mat3 mat = mInv * transposeMat3( mat3( T1, T2, N ) );
890:		  vec3 coords[ 4 ];
891:		  coords[ 0 ] = mat * ( rectCoords[ 0 ] - P );
892:		  coords[ 1 ] = mat * ( rectCoords[ 1 ] - P );
893:		  coords[ 2 ] = mat * ( rectCoords[ 2 ] - P );
894:		  coords[ 3 ] = mat * ( rectCoords[ 3 ] - P );
895:		  coords[ 0 ] = normalize( coords[ 0 ] );
896:		  coords[ 1 ] = normalize( coords[ 1 ] );
897:		  coords[ 2 ] = normalize( coords[ 2 ] );
898:		  coords[ 3 ] = normalize( coords[ 3 ] );
899:		  vec3 vectorFormFactor = vec3( 0.0 );
900:		  vectorFormFactor += LTC_EdgeVectorFormFactor( coords[ 0 ], coords[ 1 ] );
901:		  vectorFormFactor += LTC_EdgeVectorFormFactor( coords[ 1 ], coords[ 2 ] );
902:		  vectorFormFactor += LTC_EdgeVectorFormFactor( coords[ 2 ], coords[ 3 ] );
903:		  vectorFormFactor += LTC_EdgeVectorFormFactor( coords[ 3 ], coords[ 0 ] );
904:		  float result = LTC_ClippedSphereFormFactor( vectorFormFactor );
905:		  return vec3( result );
906:		}
907:		#if defined( USE_SHEEN )
908:		float D_Charlie( float roughness, float dotNH ) {
909:		  float alpha = pow2( roughness );
910:		  float invAlpha = 1.0 / alpha;
911:		  float cos2h = dotNH * dotNH;
912:		  float sin2h = max( 1.0 - cos2h, 0.0078125 );
913:		  return ( 2.0 + invAlpha ) * pow( sin2h, invAlpha * 0.5 ) / ( 2.0 * PI );
914:		}
915:		float V_Neubelt( float dotNV, float dotNL ) {
916:		  return saturate( 1.0 / ( 4.0 * ( dotNL + dotNV - dotNL * dotNV ) ) );
917:		}
918:		vec3 BRDF_Sheen( const in vec3 lightDir, const in vec3 viewDir, const in vec3 normal, vec3 sheenColor, const in float sheenRoughness ) {
919:		  vec3 halfDir = normalize( lightDir + viewDir );
920:		  float dotNL = saturate( dot( normal, lightDir ) );
921:		  float dotNV = saturate( dot( normal, viewDir ) );
922:		  float dotNH = saturate( dot( normal, halfDir ) );
