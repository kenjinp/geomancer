400:		#ifdef USE_IRIDESCENCE
401:		  const mat3 XYZ_TO_REC709 = mat3(
402:		     3.2404542, -0.9692660,  0.0556434,
403:		    -1.5371385,  1.8760108, -0.2040259,
404:		    -0.4985314,  0.0415560,  1.0572252
405:		  );
406:		  vec3 Fresnel0ToIor( vec3 fresnel0 ) {
407:		    vec3 sqrtF0 = sqrt( fresnel0 );
408:		    return ( vec3( 1.0 ) + sqrtF0 ) / ( vec3( 1.0 ) - sqrtF0 );
409:		  }
410:		  vec3 IorToFresnel0( vec3 transmittedIor, float incidentIor ) {
411:		    return pow2( ( transmittedIor - vec3( incidentIor ) ) / ( transmittedIor + vec3( incidentIor ) ) );
412:		  }
413:		  float IorToFresnel0( float transmittedIor, float incidentIor ) {
414:		    return pow2( ( transmittedIor - incidentIor ) / ( transmittedIor + incidentIor ));
415:		  }
416:		  vec3 evalSensitivity( float OPD, vec3 shift ) {
417:		    float phase = 2.0 * PI * OPD * 1.0e-9;
418:		    vec3 val = vec3( 5.4856e-13, 4.4201e-13, 5.2481e-13 );
419:		    vec3 pos = vec3( 1.6810e+06, 1.7953e+06, 2.2084e+06 );
420:		    vec3 var = vec3( 4.3278e+09, 9.3046e+09, 6.6121e+09 );
421:		    vec3 xyz = val * sqrt( 2.0 * PI * var ) * cos( pos * phase + shift ) * exp( - pow2( phase ) * var );
422:		    xyz.x += 9.7470e-14 * sqrt( 2.0 * PI * 4.5282e+09 ) * cos( 2.2399e+06 * phase + shift[ 0 ] ) * exp( - 4.5282e+09 * pow2( phase ) );
423:		    xyz /= 1.0685e-7;
424:		    vec3 rgb = XYZ_TO_REC709 * xyz;
425:		    return rgb;
426:		  }
427:		  vec3 evalIridescence( float outsideIOR, float eta2, float cosTheta1, float thinFilmThickness, vec3 baseF0 ) {
428:		    vec3 I;
429:		    float iridescenceIOR = mix( outsideIOR, eta2, smoothstep( 0.0, 0.03, thinFilmThickness ) );
430:		    float sinTheta2Sq = pow2( outsideIOR / iridescenceIOR ) * ( 1.0 - pow2( cosTheta1 ) );
431:		    float cosTheta2Sq = 1.0 - sinTheta2Sq;
432:		    if ( cosTheta2Sq < 0.0 ) {
433:		      return vec3( 1.0 );
434:		    }
435:		    float cosTheta2 = sqrt( cosTheta2Sq );
436:		    float R0 = IorToFresnel0( iridescenceIOR, outsideIOR );
437:		    float R12 = F_Schlick( R0, 1.0, cosTheta1 );
438:		    float T121 = 1.0 - R12;
439:		    float phi12 = 0.0;
440:		    if ( iridescenceIOR < outsideIOR ) phi12 = PI;
441:		    float phi21 = PI - phi12;
442:		    vec3 baseIOR = Fresnel0ToIor( clamp( baseF0, 0.0, 0.9999 ) );    vec3 R1 = IorToFresnel0( baseIOR, iridescenceIOR );
443:		    vec3 R23 = F_Schlick( R1, 1.0, cosTheta2 );
444:		    vec3 phi23 = vec3( 0.0 );
445:		    if ( baseIOR[ 0 ] < iridescenceIOR ) phi23[ 0 ] = PI;
446:		    if ( baseIOR[ 1 ] < iridescenceIOR ) phi23[ 1 ] = PI;
447:		    if ( baseIOR[ 2 ] < iridescenceIOR ) phi23[ 2 ] = PI;
448:		    float OPD = 2.0 * iridescenceIOR * thinFilmThickness * cosTheta2;
449:		    vec3 phi = vec3( phi21 ) + phi23;
450:		    vec3 R123 = clamp( R12 * R23, 1e-5, 0.9999 );
451:		    vec3 r123 = sqrt( R123 );
452:		    vec3 Rs = pow2( T121 ) * R23 / ( vec3( 1.0 ) - R123 );
453:		    vec3 C0 = R12 + Rs;
454:		    I = C0;
455:		    vec3 Cm = Rs - T121;
456:		    for ( int m = 1; m <= 2; ++ m ) {
457:		      Cm *= r123;
458:		      vec3 Sm = 2.0 * evalSensitivity( float( m ) * OPD, float( m ) * phi );
459:		      I += Cm * Sm;
460:		    }
461:		    return max( I, vec3( 0.0 ) );
462:		  }
