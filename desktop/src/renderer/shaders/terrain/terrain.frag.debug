1216:		  float VSMShadow (sampler2D shadow, vec2 uv, float compare ){
1217:		    float occlusion = 1.0;
1218:		    vec2 distribution = texture2DDistribution( shadow, uv );
1219:		    float hard_shadow = step( compare , distribution.x );
1220:		    if (hard_shadow != 1.0 ) {
1221:		      float distance = compare - distribution.x ;
1222:		      float variance = max( 0.00000, distribution.y * distribution.y );
1223:		      float softness_probability = variance / (variance + distance * distance );      softness_probability = clamp( ( softness_probability - 0.3 ) / ( 0.95 - 0.3 ), 0.0, 1.0 );      occlusion = clamp( max( hard_shadow, softness_probability ), 0.0, 1.0 );
