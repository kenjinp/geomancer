640:		float getDistanceAttenuation( const in float lightDistance, const in float cutoffDistance, const in float decayExponent ) {
641:		  float distanceFalloff = 1.0 / max( pow( lightDistance, decayExponent ), 0.01 );
642:		  if ( cutoffDistance > 0.0 ) {
643:		    distanceFalloff *= pow2( saturate( 1.0 - pow4( lightDistance / cutoffDistance ) ) );
644:		  }
645:		  return distanceFalloff;
646:		}
647:		float getSpotAttenuation( const in float coneCosine, const in float penumbraCosine, const in float angleCosine ) {
