1495:		const int NOAA_RAMP_SIZE = 18;
1496:		
1497:		vec4 noaaRampColors[NOAA_RAMP_SIZE] = vec4[](
1498:		    vec4(1.0, 1.0, 1.0, 1.0),      
1499:		    vec4(0.878, 0.843, 0.816, 1.0), 
1500:		    vec4(0.804, 0.725, 0.612, 1.0), 
1501:		    vec4(0.729, 0.580, 0.408, 1.0), 
1502:		    vec4(0.608, 0.494, 0.263, 1.0), 
1503:		    vec4(0.459, 0.459, 0.176, 1.0), 
1504:		    vec4(0.271, 0.424, 0.094, 1.0), 
1505:		    vec4(0.090, 0.333, 0.082, 1.0), 
1506:		    vec4(0.000, 0.251, 0.137, 1.0), 
1507:		    vec4(0.878, 0.988, 0.894, 1.0), 
1508:		    vec4(0.671, 0.886, 0.843, 1.0), 
1509:		    vec4(0.475, 0.776, 0.804, 1.0), 
1510:		    vec4(0.361, 0.675, 0.792, 1.0), 
1511:		    vec4(0.247, 0.569, 0.780, 1.0), 
1512:		    vec4(0.176, 0.459, 0.690, 1.0), 
1513:		    vec4(0.133, 0.333, 0.502, 1.0), 
1514:		    vec4(0.114, 0.251, 0.322, 1.0), 
1515:		    vec4(0.102, 0.204, 0.204, 1.0)  
1516:		);
1517:		
1518:		float noaaRampElevations[NOAA_RAMP_SIZE] = float[](
1519:		    8000.0,
1520:		    4000.0, 
1521:		    2000.0,
1522:		    1000.0,
1523:		    500.0,
1524:		    250.0,
1525:		    50.0,
1526:		    10.0,
1527:		    0.1,
1528:		    0.0,
1529:		    -2.0,
1530:		    -10.0,
1531:		    -50.0,
1532:		    -250.0,
1533:		    -1000.0,
1534:		    -2000.0,
1535:		    -4000.0,
1536:		    -8000.0
1537:		);
1538:		
1539:		vec4 getColorForElevation(float elevation) {
1540:		    
1541:		    if (elevation >= noaaRampElevations[0]) {
1542:		        return noaaRampColors[0];
1543:		    }
1544:		    if (elevation <= noaaRampElevations[NOAA_RAMP_SIZE-1]) {
1545:		        return noaaRampColors[NOAA_RAMP_SIZE-1];
1546:		    }
1547:		
1548:		    
1549:		    for (int i = 0; i < NOAA_RAMP_SIZE-1; i++) {
1550:		        if (elevation <= noaaRampElevations[i] && elevation > noaaRampElevations[i+1]) {
1551:		            
1552:		            float t = (elevation - noaaRampElevations[i+1]) / 
1553:		                     (noaaRampElevations[i] - noaaRampElevations[i+1]);
1554:		            return mix(noaaRampColors[i+1], noaaRampColors[i], t);
1555:		        }
1556:		    }
1557:		
1558:		    
1559:		    return noaaRampColors[0];
1560:		}
1561:		
1562:		float remap(in float value, in float x1, in float y1, in float x2, in float y2) {
1563:		    return ((value - x1) * (y2 - x2)) / (y1 - x1) + x2;
1564:		}
1565:		
1566:		float greatCircleDistance(vec3 a, vec3 b) {
1567:		    
1568:		    vec3 na = normalize(a);
1569:		    vec3 nb = normalize(b);
1570:		    
1571:		    
1572:		    float cosTheta = clamp(dot(na, nb), -1.0, 1.0);
1573:		    
1574:		    
1575:		    return acos(cosTheta);
1576:		}
1577:		
1578:		const float RAD2DEG = 180.0 / 3.1415926535897932384626433832795;
1579:		struct LatLong {
1580:		    float lat;
1581:		    float lon;
1582:		};
1583:		
1584:		LatLong getLatLong(vec3 position, float radius) {
1585:		    
1586:		    float longitude = atan(position.x, position.z) * RAD2DEG;
1587:		    float latitude = atan(-position.y, length(position.xz)) * RAD2DEG;
1588:		    return LatLong(latitude, longitude);
1589:		}
1590:		
1591:		vec2 getLatLongUV(LatLong latLong) {
1592:		    return vec2(
1593:		        remap(latLong.lon, -180., 180., 0., 1.),
1594:		        remap(latLong.lat, -90., 90., 0., 1.)
1595:		    );
1596:		}
1597:		bool getMapLayer(uint layer) {
1598:		    return bool((uMapLayers >> layer) & 1u);
1599:		}
1600:		vec2 random2(float n) {
1601:		    vec2 s = vec2(n);
1602:		    return -1.0 + 2.0 * fract(sin(vec2(dot(s,vec2(127.1,311.7)),
1603:		                                     dot(s,vec2(269.5,183.3))))*43758.5453123);
1604:		}
1605:		
1606:		vec3 hash31(float p) {
1607:		   vec3 p3 = fract(vec3(p) * vec3(.1031, .1030, .0973));
1608:		   p3 += dot(p3, p3.yzx+33.33);
1609:		   return fract((p3.xxy+p3.yzz)*p3.zyx); 
1610:		}
1611:		
1612:		vec3 hashFloat(float f) {
1613:		    
1614:		    uint seed = uint(f);
1615:		    
1616:		    
1617:		    seed ^= (seed << 13u);
1618:		    seed ^= (seed >> 17u);
1619:		    seed ^= (seed << 5u);
1620:		    
1621:		    
1622:		    return vec3(
1623:		        float((seed >> 16u) & 0xFFu) / 255.0,
1624:		        float((seed >> 8u) & 0xFFu) / 255.0,
1625:		        float(seed & 0xFFu) / 255.0
1626:		    );
1627:		}
1628:		
1629:		vec3 jitterPosition(vec3 position, float seed, float amount) {
1630:		    
1631:		    vec2 rand = random2(seed);
1632:		    vec3 tangent = normalize(cross(position, vec3(0.0, 1.0, 0.0)));
1633:		    vec3 bitangent = normalize(cross(position, tangent));
1634:		    
1635:		    
1636:		    return normalize(position + (tangent * rand.x + bitangent * rand.y) * amount);
1637:		}
1638:		uint getNeighborH3Id(float baseId, float direction) {
1639:		    
1640:		    float index = baseId * 6.0 + direction;
1641:		    vec2 texSize = vec2(textureSize(h3NeighborMap, 0));
1642:		    float texWidth = texSize.x;
1643:		    float texHeight = texSize.y;
1644:		
1645:		    
1646:		    float row = floor(index / texWidth);
1647:		    float col = mod(index, texWidth);
1648:		
1649:		    
1650:		    vec2 uv = vec2(
1651:		        (col + 0.5) / texWidth,
1652:		        (row + 0.5) / texHeight
1653:		    );
1654:		
1655:		    vec4 packed = texture2D(h3NeighborMap, uv);
1656:		    
1657:		    
1658:		    uint r = uint(floor(packed.r * 255.0 + 0.5));
1659:		    uint g = uint(floor(packed.g * 255.0 + 0.5));
1660:		    uint b = uint(floor(packed.b * 255.0 + 0.5));
1661:		    
1662:		    
1663:		    if (r == 255u && g == 255u && b == 255u) {
1664:		        return 0u;
1665:		    }
1666:		    
1667:		    return (r << 16u) | (g << 8u) | b;
1668:		}
1669:		
1670:		vec3 getH3Position(float h3Id) {
1671:		    ivec2 texSize = textureSize(h3PositionMap, 0);
1672:		    float texWidth = float(texSize.x);
1673:		    float texHeight = float(texSize.y);
1674:		    
1675:		    
1676:		    float row = floor(h3Id / texWidth);
1677:		    float col = h3Id - row * texWidth;
1678:		
1679:		    
1680:		    row = min(row, texHeight - 1.0);
1681:		
1682:		    
1683:		    vec2 uv = vec2(
1684:		        (col + 0.5) / texWidth,
1685:		        (row + 0.5) / texHeight
1686:		    );
1687:		
1688:		    vec3 position = texture2D(h3PositionMap, uv).xyz;
1689:		    
1690:		    return position;
1691:		}
1692:		
1693:		uint getH3IdentifierCube(vec3 direction) {
1694:		    vec4 color = textureCube(h3IndexMap, direction);
1695:		    uint r = uint(floor(color.r * 255.0 + 0.5));
1696:		    uint g = uint(floor(color.g * 255.0 + 0.5));
1697:		    uint b = uint(floor(color.b * 255.0 + 0.5));
1698:		
1699:		    
1700:		    if (r == 255u && g == 255u && b == 255u) {
1701:		        return 0u;
1702:		    }
1703:		
1704:		    return (r << 16) | (g << 8) | b;
1705:		}
1706:		
1707:		uint findClosestCell(vec3 position, uint initialId) {
1708:		    vec3 normalizedPos = normalize(position);
1709:		    vec3 initialCenter = normalize(getH3Position(float(initialId)));
1710:		    float minDist = greatCircleDistance(normalizedPos, initialCenter);
1711:		    uint closestId = initialId;
1712:		    
1713:		    for (int i = 0; i < 6; i++) {
1714:		        uint neighborId = getNeighborH3Id(float(initialId), float(i));
1715:		        if (neighborId == 0u) continue;
1716:		        
1717:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
1718:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
1719:		        
1720:		        if (dist < minDist) {
1721:		            minDist = dist;
1722:		            closestId = neighborId;
1723:		        }
1724:		    }
1725:		    
1726:		    return closestId;
1727:		}
1728:		
1729:		vec2 findClosestAndSecondClosestCell(vec3 position, uint initialId) {
1730:		    vec3 normalizedPos = normalize(position);
1731:		    vec3 initialCenter = normalize(getH3Position(float(initialId)));
1732:		    float minDist = greatCircleDistance(normalizedPos, initialCenter);
1733:		    float secondMinDist = 1000.0;
1734:		    uint closestId = initialId;
1735:		    uint secondClosestId = initialId;
1736:		    
1737:		    for (int i = 0; i < 6; i++) {
1738:		        uint neighborId = getNeighborH3Id(float(initialId), float(i));
1739:		        if (neighborId == 0u) continue;
1740:		        
1741:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
1742:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
1743:		        
1744:		        if (dist < minDist) {
1745:		            secondMinDist = minDist;
1746:		            secondClosestId = closestId;
1747:		            minDist = dist;
1748:		            closestId = neighborId;
1749:		        } else if (dist < secondMinDist) {
1750:		            secondMinDist = dist;
1751:		            secondClosestId = neighborId;
1752:		        }
1753:		    }
1754:		    
1755:		    return vec2(float(closestId), float(secondClosestId));
1756:		}
1757:		vec2 getHexTileUV(float tileIndex, vec2 textureSize) {
1758:		    float row = floor(tileIndex / textureSize.x);
1759:		    float col = mod(tileIndex, textureSize.x);
1760:		    
1761:		    return vec2(
1762:		        (col + 0.5) / textureSize.x,
1763:		        (row + 0.5) / textureSize.y
1764:		    );
1765:		}
1766:		
1767:		struct HexTileIntData {
1768:		    uint tectonicPlate;
1769:		    uint crustData;
1770:		    uint biomeData;
1771:		    uint reserved;
1772:		};
1773:		
1774:		HexTileIntData getHexTileIntData(float tileIndex) {
1775:		    vec2 textureSize = vec2(textureSize(hexTileIntBuffer, 0));
1776:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
1777:		    uvec4 rawData = texture(hexTileIntBuffer, uv);
1778:		    
1779:		    HexTileIntData result;
1780:		    result.tectonicPlate = rawData.r;
1781:		    result.crustData = rawData.g;
1782:		    result.biomeData = rawData.b;
1783:		    result.reserved = rawData.a;
1784:		    
1785:		    return result;
1786:		}
1787:		
1788:		bool isOceanicCrust(uint crustData) {
1789:		    return (crustData / 10u) == 0u;
1790:		}
1791:		
1792:		uint getCrustSubtype(uint crustData) {
1793:		    return crustData % 10u;
1794:		}
1795:		
1796:		uint getBiomeType(uint biomeData) {
1797:		    return biomeData >> 1u;
1798:		}
1799:		
1800:		bool hasHotspot(uint biomeData) {
1801:		    return (biomeData & 1u) == 1u;
1802:		}
1803:		
1804:		struct HexTileFloatData {
1805:		    float evapotranspiration;
1806:		    float annualPrecipitation;
1807:		    float annualTemperature;
1808:		    float elevation;
1809:		};
1810:		
1811:		float validateHexTileFloatData(float tileIndex) {
1812:		    vec2 textureSize = vec2(textureSize(hexTileFloatBuffer, 0));
1813:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
1814:		    vec4 data = texture2D(hexTileFloatBuffer, uv);
1815:		    return data.a;
1816:		}
1817:		
1818:		HexTileFloatData getHexTileFloatData(float tileIndex) {
1819:		    vec2 textureSize = vec2(textureSize(hexTileFloatBuffer, 0));
1820:		    vec2 uv = getHexTileUV(tileIndex, textureSize);
1821:		    vec4 data = texture2D(hexTileFloatBuffer, uv);
1822:		    
1823:		    HexTileFloatData result;
1824:		    result.evapotranspiration = data.r;
1825:		    result.annualPrecipitation = data.g * 5000.0; 
1826:		    result.annualTemperature = data.b * 100.0 - 50.0; 
1827:		    result.elevation = data.a;
1828:		    
1829:		    return result;
1830:		}
1831:		float getGrid(vec2 localPosition, float size, float thickness) {
1832:		    vec2 r = localPosition.xy / size;
1833:		    vec2 grid = abs(fract(r - 0.5) - 0.5) / fwidth(r);
1834:		    float line = min(grid.x, grid.y) + 1.0 - thickness;
1835:		    return 1.0 - min(line, 1.0);
1836:		}
1837:		
1838:		float getGridFromFloat(float localPosition, float size, float thickness) {
1839:		    float r = localPosition / size;
1840:		    float grid = abs(fract(r - 0.5) - 0.5) / fwidth(r);
1841:		    float line = grid + 1.0 - thickness;
1842:		    return 1.0 - min(line, 1.0);
1843:		}
1844:		
1845:		float getEdgeFactor(vec3 position, uint cellId, float edgeWidth) {
1846:		    vec3 normalizedPos = normalize(position);
1847:		    vec3 cellCenter = normalize(getH3Position(float(cellId)));
1848:		    float distToCenter = greatCircleDistance(normalizedPos, cellCenter);
1849:		    
1850:		    
1851:		    float minNeighborDist = 1000.0;
1852:		    for (int i = 0; i < 6; i++) {
1853:		        uint neighborId = getNeighborH3Id(float(cellId), float(i));
1854:		        if (neighborId == 0u) continue;
1855:		        
1856:		        vec3 neighborCenter = normalize(getH3Position(float(neighborId)));
1857:		        float dist = greatCircleDistance(normalizedPos, neighborCenter);
1858:		        minNeighborDist = min(minNeighborDist, dist);
1859:		    }
1860:		    
1861:		    
1862:		    float edgeSharpness = 4.0;
1863:		    
1864:		    
1865:		    float edgeFactor = abs(distToCenter - minNeighborDist);
1866:		    return 1.0 - smoothstep(0.0, edgeWidth, edgeFactor * edgeSharpness);
1867:		}
1868:		float calculateDiffuseLighting(vec3 normal, vec3 lightDir) {
1869:		    return max(dot(normal, lightDir), 0.0);
1870:		}
1871:		
1872:		vec3 calculateSurfaceNormal(vec3 position, uint cellId) {
1873:		    
1874:		    vec3 cellCenter = normalize(getH3Position(float(cellId)));
1875:		    
1876:		    
1877:		    return normalize(position);
1878:		}
1879:		
1880:		vec3 applyLighting(vec3 baseColor, vec3 normal, vec3 lightDir) {
1881:		    
1882:		    float ambientStrength = 0.00001;
1883:		    vec3 ambient = ambientStrength * baseColor;
1884:		    
1885:		    
1886:		    float diff = calculateDiffuseLighting(normal, lightDir);
1887:		    vec3 diffuse = diff * baseColor;
1888:		    
1889:		    
1890:		    return ambient + diffuse;
1891:		}
