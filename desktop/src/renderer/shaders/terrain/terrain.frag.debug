182:		vec3 F_Schlick( const in vec3 f0, const in float f90, const in float dotVH ) {
183:		  float fresnel = exp2( ( - 5.55473 * dotVH - 6.98316 ) * dotVH );
184:		  return f0 * ( 1.0 - fresnel ) + ( f90 * fresnel );
185:		}
186:		float F_Schlick( const in float f0, const in float f90, const in float dotVH ) {
187:		  float fresnel = exp2( ( - 5.55473 * dotVH - 6.98316 ) * dotVH );
188:		  return f0 * ( 1.0 - fresnel ) + ( f90 * fresnel );
189:		} // validated
