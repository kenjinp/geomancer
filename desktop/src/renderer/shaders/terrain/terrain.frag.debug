1280:		           f.x ) +
1281:		        mix( texture2DCompare( shadowMap, uv + vec2( 0.0, -dy ), shadowCoord.z ),
1282:		           texture2DCompare( shadowMap, uv + vec2( 0.0, 2.0 * dy ), shadowCoord.z ),
1283:		           f.y ) +
1284:		        mix( texture2DCompare( shadowMap, uv + vec2( dx, -dy ), shadowCoord.z ),
1285:		           texture2DCompare( shadowMap, uv + vec2( dx, 2.0 * dy ), shadowCoord.z ),
1286:		           f.y ) +
1287:		        mix( mix( texture2DCompare( shadowMap, uv + vec2( -dx, -dy ), shadowCoord.z ),
1288:		              texture2DCompare( shadowMap, uv + vec2( 2.0 * dx, -dy ), shadowCoord.z ),
1289:		              f.x ),
1290:		           mix( texture2DCompare( shadowMap, uv + vec2( -dx, 2.0 * dy ), shadowCoord.z ),
1291:		              texture2DCompare( shadowMap, uv + vec2( 2.0 * dx, 2.0 * dy ), shadowCoord.z ),
1292:		              f.x ),
1293:		           f.y )
1294:		      ) * ( 1.0 / 9.0 );
1295:		    #elif defined( SHADOWMAP_TYPE_VSM )
1296:		      shadow = VSMShadow( shadowMap, shadowCoord.xy, shadowCoord.z );
1297:		    #else
1298:		      shadow = texture2DCompare( shadowMap, shadowCoord.xy, shadowCoord.z );
1299:		    #endif
1300:		    }
1301:		    return mix( 1.0, shadow, shadowIntensity );
1302:		  }
1303:		  vec2 cubeToUV( vec3 v, float texelSizeY ) {
1304:		    vec3 absV = abs( v );
1305:		    float scaleToCube = 1.0 / max( absV.x, max( absV.y, absV.z ) );
1306:		    absV *= scaleToCube;
1307:		    v *= scaleToCube * ( 1.0 - 2.0 * texelSizeY );
1308:		    vec2 planar = v.xy;
1309:		    float almostATexel = 1.5 * texelSizeY;
1310:		    float almostOne = 1.0 - almostATexel;
1311:		    if ( absV.z >= almostOne ) {
1312:		      if ( v.z > 0.0 )
1313:		        planar.x = 4.0 - v.x;
1314:		    } else if ( absV.x >= almostOne ) {
1315:		      float signX = sign( v.x );
1316:		      planar.x = v.z * signX + 2.0 * signX;
1317:		    } else if ( absV.y >= almostOne ) {
1318:		      float signY = sign( v.y );
1319:		      planar.x = v.x + 2.0 * signY + 2.0;
1320:		      planar.y = v.z * signY - 2.0;
1321:		    }
1322:		    return vec2( 0.125, 0.25 ) * planar + vec2( 0.375, 0.75 );
1323:		  }
1324:		  float getPointShadow( sampler2D shadowMap, vec2 shadowMapSize, float shadowIntensity, float shadowBias, float shadowRadius, vec4 shadowCoord, float shadowCameraNear, float shadowCameraFar ) {
1325:		    float shadow = 1.0;
1326:		    vec3 lightToPosition = shadowCoord.xyz;
1327:		    
1328:		    float lightToPositionLength = length( lightToPosition );
1329:		    if ( lightToPositionLength - shadowCameraFar <= 0.0 && lightToPositionLength - shadowCameraNear >= 0.0 ) {
1330:		      float dp = ( lightToPositionLength - shadowCameraNear ) / ( shadowCameraFar - shadowCameraNear );      dp += shadowBias;
1331:		      vec3 bd3D = normalize( lightToPosition );
1332:		      vec2 texelSize = vec2( 1.0 ) / ( shadowMapSize * vec2( 4.0, 2.0 ) );
1333:		      #if defined( SHADOWMAP_TYPE_PCF ) || defined( SHADOWMAP_TYPE_PCF_SOFT ) || defined( SHADOWMAP_TYPE_VSM )
1334:		        vec2 offset = vec2( - 1, 1 ) * shadowRadius * texelSize.y;
1335:		        shadow = (
1336:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.xyy, texelSize.y ), dp ) +
1337:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.yyy, texelSize.y ), dp ) +
1338:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.xyx, texelSize.y ), dp ) +
1339:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.yyx, texelSize.y ), dp ) +
1340:		          texture2DCompare( shadowMap, cubeToUV( bd3D, texelSize.y ), dp ) +
1341:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.xxy, texelSize.y ), dp ) +
1342:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.yxy, texelSize.y ), dp ) +
1343:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.xxx, texelSize.y ), dp ) +
1344:		          texture2DCompare( shadowMap, cubeToUV( bd3D + offset.yxx, texelSize.y ), dp )
1345:		        ) * ( 1.0 / 9.0 );
1346:		      #else
1347:		        shadow = texture2DCompare( shadowMap, cubeToUV( bd3D, texelSize.y ), dp );
1348:		      #endif
1349:		    }
1350:		    return mix( 1.0, shadow, shadowIntensity );
1351:		  }
1352:		#endif
1353:		#ifdef USE_BUMPMAP
1354:		  uniform sampler2D bumpMap;
1355:		  uniform float bumpScale;
1356:		  vec2 dHdxy_fwd() {
1357:		    vec2 dSTdx = dFdx( vBumpMapUv );
1358:		    vec2 dSTdy = dFdy( vBumpMapUv );
1359:		    float Hll = bumpScale * texture2D( bumpMap, vBumpMapUv ).x;
1360:		    float dBx = bumpScale * texture2D( bumpMap, vBumpMapUv + dSTdx ).x - Hll;
1361:		    float dBy = bumpScale * texture2D( bumpMap, vBumpMapUv + dSTdy ).x - Hll;
1362:		    return vec2( dBx, dBy );
1363:		  }
1364:		  vec3 perturbNormalArb( vec3 surf_pos, vec3 surf_norm, vec2 dHdxy, float faceDirection ) {
1365:		    vec3 vSigmaX = normalize( dFdx( surf_pos.xyz ) );
1366:		    vec3 vSigmaY = normalize( dFdy( surf_pos.xyz ) );
1367:		    vec3 vN = surf_norm;
1368:		    vec3 R1 = cross( vSigmaY, vN );
1369:		    vec3 R2 = cross( vN, vSigmaX );
1370:		    float fDet = dot( vSigmaX, R1 ) * faceDirection;
1371:		    vec3 vGrad = sign( fDet ) * ( dHdxy.x * R1 + dHdxy.y * R2 );
1372:		    return normalize( abs( fDet ) * surf_norm - vGrad );
1373:		  }
1374:		#endif
1375:		#ifdef USE_NORMALMAP
1376:		  uniform sampler2D normalMap;
1377:		  uniform vec2 normalScale;
1378:		#endif
1379:		#ifdef USE_NORMALMAP_OBJECTSPACE
1380:		  uniform mat3 normalMatrix;
1381:		#endif
1382:		#if ! defined ( USE_TANGENT ) && ( defined ( USE_NORMALMAP_TANGENTSPACE ) || defined ( USE_CLEARCOAT_NORMALMAP ) || defined( USE_ANISOTROPY ) )
1383:		  mat3 getTangentFrame( vec3 eye_pos, vec3 surf_norm, vec2 uv ) {
1384:		    vec3 q0 = dFdx( eye_pos.xyz );
1385:		    vec3 q1 = dFdy( eye_pos.xyz );
1386:		    vec2 st0 = dFdx( uv.st );
1387:		    vec2 st1 = dFdy( uv.st );
1388:		    vec3 N = surf_norm;
1389:		    vec3 q1perp = cross( q1, N );
1390:		    vec3 q0perp = cross( N, q0 );
1391:		    vec3 T = q1perp * st0.x + q0perp * st1.x;
1392:		    vec3 B = q1perp * st0.y + q0perp * st1.y;
1393:		    float det = max( dot( T, T ), dot( B, B ) );
1394:		    float scale = ( det == 0.0 ) ? 0.0 : inversesqrt( det );
1395:		    return mat3( T * scale, B * scale, N );
1396:		  }
1397:		#endif
