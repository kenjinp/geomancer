467:		  float getFace( vec3 direction ) {
468:		    vec3 absDirection = abs( direction );
469:		    float face = - 1.0;
470:		    if ( absDirection.x > absDirection.z ) {
471:		      if ( absDirection.x > absDirection.y )
472:		        face = direction.x > 0.0 ? 0.0 : 3.0;
473:		      else
474:		        face = direction.y > 0.0 ? 1.0 : 4.0;
475:		    } else {
476:		      if ( absDirection.z > absDirection.y )
477:		        face = direction.z > 0.0 ? 2.0 : 5.0;
478:		      else
479:		        face = direction.y > 0.0 ? 1.0 : 4.0;
480:		    }
481:		    return face;
482:		  }
483:		  vec2 getUV( vec3 direction, float face ) {
484:		    vec2 uv;
485:		    if ( face == 0.0 ) {
486:		      uv = vec2( direction.z, direction.y ) / abs( direction.x );
487:		    } else if ( face == 1.0 ) {
488:		      uv = vec2( - direction.x, - direction.z ) / abs( direction.y );
489:		    } else if ( face == 2.0 ) {
490:		      uv = vec2( - direction.x, direction.y ) / abs( direction.z );
491:		    } else if ( face == 3.0 ) {
492:		      uv = vec2( - direction.z, direction.y ) / abs( direction.x );
493:		    } else if ( face == 4.0 ) {
494:		      uv = vec2( - direction.x, direction.z ) / abs( direction.y );
495:		    } else {
496:		      uv = vec2( direction.x, direction.y ) / abs( direction.z );
497:		    }
498:		    return 0.5 * ( uv + 1.0 );
499:		  }
500:		  vec3 bilinearCubeUV( sampler2D envMap, vec3 direction, float mipInt ) {
501:		    float face = getFace( direction );
502:		    float filterInt = max( cubeUV_minMipLevel - mipInt, 0.0 );
503:		    mipInt = max( mipInt, cubeUV_minMipLevel );
504:		    float faceSize = exp2( mipInt );
505:		    highp vec2 uv = getUV( direction, face ) * ( faceSize - 2.0 ) + 1.0;
506:		    if ( face > 2.0 ) {
507:		      uv.y += faceSize;
508:		      face -= 3.0;
509:		    }
510:		    uv.x += face * faceSize;
511:		    uv.x += filterInt * 3.0 * cubeUV_minTileSize;
512:		    uv.y += 4.0 * ( exp2( CUBEUV_MAX_MIP ) - faceSize );
513:		    uv.x *= CUBEUV_TEXEL_WIDTH;
514:		    uv.y *= CUBEUV_TEXEL_HEIGHT;
515:		    #ifdef texture2DGradEXT
516:		      return texture2DGradEXT( envMap, uv, vec2( 0.0 ), vec2( 0.0 ) ).rgb;
517:		    #else
518:		      return texture2D( envMap, uv ).rgb;
519:		    #endif
520:		  }
521:		  #define cubeUV_r0 1.0
522:		  #define cubeUV_m0 - 2.0
523:		  #define cubeUV_r1 0.8
524:		  #define cubeUV_m1 - 1.0
525:		  #define cubeUV_r4 0.4
526:		  #define cubeUV_m4 2.0
527:		  #define cubeUV_r5 0.305
528:		  #define cubeUV_m5 3.0
529:		  #define cubeUV_r6 0.21
530:		  #define cubeUV_m6 4.0
531:		  float roughnessToMip( float roughness ) {
532:		    float mip = 0.0;
533:		    if ( roughness >= cubeUV_r1 ) {
534:		      mip = ( cubeUV_r0 - roughness ) * ( cubeUV_m1 - cubeUV_m0 ) / ( cubeUV_r0 - cubeUV_r1 ) + cubeUV_m0;
535:		    } else if ( roughness >= cubeUV_r4 ) {
536:		      mip = ( cubeUV_r1 - roughness ) * ( cubeUV_m4 - cubeUV_m1 ) / ( cubeUV_r1 - cubeUV_r4 ) + cubeUV_m1;
537:		    } else if ( roughness >= cubeUV_r5 ) {
538:		      mip = ( cubeUV_r4 - roughness ) * ( cubeUV_m5 - cubeUV_m4 ) / ( cubeUV_r4 - cubeUV_r5 ) + cubeUV_m4;
539:		    } else if ( roughness >= cubeUV_r6 ) {
540:		      mip = ( cubeUV_r5 - roughness ) * ( cubeUV_m6 - cubeUV_m5 ) / ( cubeUV_r5 - cubeUV_r6 ) + cubeUV_m5;
541:		    } else {
542:		      mip = - 2.0 * log2( 1.16 * roughness );    }
543:		    return mip;
544:		  }
545:		  vec4 textureCubeUV( sampler2D envMap, vec3 sampleDir, float roughness ) {
546:		    float mip = clamp( roughnessToMip( roughness ), cubeUV_m0, CUBEUV_MAX_MIP );
547:		    float mipF = fract( mip );
548:		    float mipInt = floor( mip );
549:		    vec3 color0 = bilinearCubeUV( envMap, sampleDir, mipInt );
550:		    if ( mipF == 0.0 ) {
551:		      return vec4( color0, 1.0 );
552:		    } else {
553:		      vec3 color1 = bilinearCubeUV( envMap, sampleDir, mipInt + 1.0 );
554:		      return vec4( mix( color0, color1, mipF ), 1.0 );
555:		    }
556:		  }
