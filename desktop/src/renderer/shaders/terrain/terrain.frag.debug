196:		const float PackUpscale = 256. / 255.;const float UnpackDownscale = 255. / 256.;const float ShiftRight8 = 1. / 256.;
197:		const float Inv255 = 1. / 255.;
198:		const vec4 PackFactors = vec4( 1.0, 256.0, 256.0 * 256.0, 256.0 * 256.0 * 256.0 );
199:		const vec2 UnpackFactors2 = vec2( UnpackDownscale, 1.0 / PackFactors.g );
200:		const vec3 UnpackFactors3 = vec3( UnpackDownscale / PackFactors.rg, 1.0 / PackFactors.b );
201:		const vec4 UnpackFactors4 = vec4( UnpackDownscale / PackFactors.rgb, 1.0 / PackFactors.a );
202:		vec4 packDepthToRGBA( const in float v ) {
203:		  if( v <= 0.0 )
204:		    return vec4( 0., 0., 0., 0. );
205:		  if( v >= 1.0 )
206:		    return vec4( 1., 1., 1., 1. );
207:		  float vuf;
208:		  float af = modf( v * PackFactors.a, vuf );
209:		  float bf = modf( vuf * ShiftRight8, vuf );
210:		  float gf = modf( vuf * ShiftRight8, vuf );
211:		  return vec4( vuf * Inv255, gf * PackUpscale, bf * PackUpscale, af );
212:		}
213:		vec3 packDepthToRGB( const in float v ) {
214:		  if( v <= 0.0 )
215:		    return vec3( 0., 0., 0. );
216:		  if( v >= 1.0 )
217:		    return vec3( 1., 1., 1. );
218:		  float vuf;
219:		  float bf = modf( v * PackFactors.b, vuf );
220:		  float gf = modf( vuf * ShiftRight8, vuf );
221:		  return vec3( vuf * Inv255, gf * PackUpscale, bf );
222:		}
223:		vec2 packDepthToRG( const in float v ) {
224:		  if( v <= 0.0 )
225:		    return vec2( 0., 0. );
226:		  if( v >= 1.0 )
227:		    return vec2( 1., 1. );
228:		  float vuf;
229:		  float gf = modf( v * 256., vuf );
230:		  return vec2( vuf * Inv255, gf );
231:		}
232:		float unpackRGBAToDepth( const in vec4 v ) {
233:		  return dot( v, UnpackFactors4 );
234:		}
235:		float unpackRGBToDepth( const in vec3 v ) {
236:		  return dot( v, UnpackFactors3 );
237:		}
238:		float unpackRGToDepth( const in vec2 v ) {
239:		  return v.r * UnpackFactors2.r + v.g * UnpackFactors2.g;
240:		}
241:		vec4 pack2HalfToRGBA( const in vec2 v ) {
242:		  vec4 r = vec4( v.x, fract( v.x * 255.0 ), v.y, fract( v.y * 255.0 ) );
243:		  return vec4( r.x - r.y / 255.0, r.y, r.z - r.w / 255.0, r.w );
244:		}
245:		vec2 unpackRGBATo2Half( const in vec4 v ) {
246:		  return vec2( v.x + ( v.y / 255.0 ), v.z + ( v.w / 255.0 ) );
247:		}
248:		float viewZToOrthographicDepth( const in float viewZ, const in float near, const in float far ) {
249:		  return ( viewZ + near ) / ( near - far );
250:		}
251:		float orthographicDepthToViewZ( const in float depth, const in float near, const in float far ) {
252:		  return depth * ( near - far ) - near;
253:		}
254:		float viewZToPerspectiveDepth( const in float viewZ, const in float near, const in float far ) {
255:		  return ( ( near + viewZ ) * far ) / ( ( far - near ) * viewZ );
256:		}
257:		float perspectiveDepthToViewZ( const in float depth, const in float near, const in float far ) {
258:		  return ( near * far ) / ( ( far - near ) * depth - far );
259:		}
