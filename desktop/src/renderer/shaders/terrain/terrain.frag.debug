1079:		  vec4 bicubic( sampler2D tex, vec2 uv, vec4 texelSize, float lod ) {
1080:		    uv = uv * texelSize.zw + 0.5;
1081:		    vec2 iuv = floor( uv );
1082:		    vec2 fuv = fract( uv );
1083:		    float g0x = g0( fuv.x );
1084:		    float g1x = g1( fuv.x );
1085:		    float h0x = h0( fuv.x );
1086:		    float h1x = h1( fuv.x );
1087:		    float h0y = h0( fuv.y );
1088:		    float h1y = h1( fuv.y );
1089:		    vec2 p0 = ( vec2( iuv.x + h0x, iuv.y + h0y ) - 0.5 ) * texelSize.xy;
1090:		    vec2 p1 = ( vec2( iuv.x + h1x, iuv.y + h0y ) - 0.5 ) * texelSize.xy;
1091:		    vec2 p2 = ( vec2( iuv.x + h0x, iuv.y + h1y ) - 0.5 ) * texelSize.xy;
1092:		    vec2 p3 = ( vec2( iuv.x + h1x, iuv.y + h1y ) - 0.5 ) * texelSize.xy;
1093:		    return g0( fuv.y ) * ( g0x * textureLod( tex, p0, lod ) + g1x * textureLod( tex, p1, lod ) ) +
