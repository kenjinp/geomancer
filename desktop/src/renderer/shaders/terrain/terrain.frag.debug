1096:		  vec4 textureBicubic( sampler2D sampler, vec2 uv, float lod ) {
1097:		    vec2 fLodSize = vec2( textureSize( sampler, int( lod ) ) );
1098:		    vec2 cLodSize = vec2( textureSize( sampler, int( lod + 1.0 ) ) );
1099:		    vec2 fLodSizeInv = 1.0 / fLodSize;
1100:		    vec2 cLodSizeInv = 1.0 / cLodSize;
1101:		    vec4 fSample = bicubic( sampler, uv, vec4( fLodSizeInv, fLodSize ), floor( lod ) );
1102:		    vec4 cSample = bicubic( sampler, uv, vec4( cLodSizeInv, cLodSize ), ceil( lod ) );
1103:		    return mix( fSample, cSample, fract( lod ) );
