174:		vec2 equirectUv( in vec3 dir ) {
175:		  float u = atan( dir.z, dir.x ) * RECIPROCAL_PI2 + 0.5;
176:		  float v = asin( clamp( dir.y, - 1.0, 1.0 ) ) * RECIPROCAL_PI + 0.5;
177:		  return vec2( u, v );
178:		}
