618:		vec3 shGetIrradianceAt( in vec3 normal, in vec3 shCoefficients[ 9 ] ) {
619:		  float x = normal.x, y = normal.y, z = normal.z;
620:		  vec3 result = shCoefficients[ 0 ] * 0.886227;
621:		  result += shCoefficients[ 1 ] * 2.0 * 0.511664 * y;
622:		  result += shCoefficients[ 2 ] * 2.0 * 0.511664 * z;
623:		  result += shCoefficients[ 3 ] * 2.0 * 0.511664 * x;
624:		  result += shCoefficients[ 4 ] * 2.0 * 0.429043 * x * y;
625:		  result += shCoefficients[ 5 ] * 2.0 * 0.429043 * y * z;
626:		  result += shCoefficients[ 6 ] * ( 0.743125 * z * z - 0.247708 );
627:		  result += shCoefficients[ 7 ] * 2.0 * 0.429043 * x * z;
628:		  result += shCoefficients[ 8 ] * 0.429043 * ( x * x - y * y );
629:		  return result;
630:		}
631:		vec3 getLightProbeIrradiance( const in vec3 lightProbe[ 9 ], const in vec3 normal ) {
632:		  vec3 worldNormal = inverseTransformDirection( normal, viewMatrix );
633:		  vec3 irradiance = shGetIrradianceAt( worldNormal, lightProbe );
634:		  return irradiance;
635:		}
