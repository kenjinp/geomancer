353:		#ifdef USE_ALPHAHASH
354:		  const float ALPHA_HASH_SCALE = 0.05;
355:		  float hash2D( vec2 value ) {
356:		    return fract( 1.0e4 * sin( 17.0 * value.x + 0.1 * value.y ) * ( 0.1 + abs( sin( 13.0 * value.y + value.x ) ) ) );
357:		  }
358:		  float hash3D( vec3 value ) {
359:		    return hash2D( vec2( hash2D( value.xy ), value.z ) );
360:		  }
361:		  float getAlphaHashThreshold( vec3 position ) {
362:		    float maxDeriv = max(
363:		      length( dFdx( position.xyz ) ),
364:		      length( dFdy( position.xyz ) )
365:		    );
366:		    float pixScale = 1.0 / ( ALPHA_HASH_SCALE * maxDeriv );
367:		    vec2 pixScales = vec2(
368:		      exp2( floor( log2( pixScale ) ) ),
369:		      exp2( ceil( log2( pixScale ) ) )
370:		    );
371:		    vec2 alpha = vec2(
372:		      hash3D( floor( pixScales.x * position.xyz ) ),
373:		      hash3D( floor( pixScales.y * position.xyz ) )
374:		    );
375:		    float lerpFactor = fract( log2( pixScale ) );
376:		    float x = ( 1.0 - lerpFactor ) * alpha.x + lerpFactor * alpha.y;
377:		    float a = min( lerpFactor, 1.0 - lerpFactor );
378:		    vec3 cases = vec3(
379:		      x * x / ( 2.0 * a * ( 1.0 - a ) ),
380:		      ( x - 0.5 * a ) / ( 1.0 - a ),
381:		      1.0 - ( ( 1.0 - x ) * ( 1.0 - x ) / ( 2.0 * a * ( 1.0 - a ) ) )
382:		    );
383:		    float threshold = ( x < ( 1.0 - a ) )
384:		      ? ( ( x < a ) ? cases.x : cases.y )
385:		      : cases.z;
386:		    return clamp( threshold , 1.0e-6, 1.0 );
387:		  }
388:		#endif
